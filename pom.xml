<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.beestream</groupId>
    <artifactId>jitcast</artifactId>
    <version>0.1.0${jdk.version.suffix}</version>
    <packaging>jar</packaging>

    <name>jitcast</name>
    <description>An inference engine for NX-AI TiRex-2 time-series forecasting on TornadoVM, with the hybrid CUDA libraries (cuBLAS) and CUDA Tile</description>

    <url>https://github.com/beestream-ai/jitcast</url>
    <organization>
        <name>Beestream Ltd</name>
        <url>https://github.com/beestream-ai</url>
    </organization>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The TornadoVM artifacts this builds against (for a development build: -Dtornadovm.version=7.0.2-jdk22plus-dev). -->
        <jdk.version.suffix>-jdk22plus</jdk.version.suffix>
        <tornadovm.version>7.3.1${jdk.version.suffix}</tornadovm.version>
        <maven.compiler.release>22</maven.compiler.release>
        <!-- Golden-data tests skip unless both are set: the converted weights
             (scripts/convert_ckpt.py) and a golden directory (scripts/dump_golden.py). The device tests
             of reduced-precision configurations also need NXAI's CUDA goldens (dump_golden.py with device cuda),
             whose distance from the FP32 goldens sets their limits. -->
        <tirex.weights></tirex.weights>
        <tirex.golden></tirex.golden>
        <tirex.golden.gpu></tirex.golden.gpu>
    </properties>

    <dependencies>
        <!-- Provided: the TornadoVM SDK supplies these at runtime (as in jitllm, issue #176). -->
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-cublas</artifactId>
            <version>${tornadovm.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- Default tests need no accelerator; *AccelTest runs under -Paccel-tests, as in jitllm. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <excludes>
                        <exclude>**/*AccelTest.java</exclude>
                    </excludes>
                    <argLine>--add-modules jdk.incubator.vector</argLine>
                    <systemPropertyVariables>
                        <tirex.weights>${tirex.weights}</tirex.weights>
                        <tirex.golden>${tirex.golden}</tirex.golden>
                        <tirex.golden.gpu>${tirex.golden.gpu}</tirex.golden.gpu>
                        <timestral.checkpoint>${timestral.checkpoint}</timestral.checkpoint>
                        <timestral.golden>${timestral.golden}</timestral.golden>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>accel-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <argLine>@${env.TORNADOVM_HOME}/tornado-argfile
                                    --add-modules jdk.incubator.vector
                                    -da:tornado.graal...
                                    -Dtornado.recover.bailout=False
                                    -Dtornado.device.memory=8GB
                                    -Dtornado.cuda.priority=100
                                    -Dtornado.opencl.priority=0</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
